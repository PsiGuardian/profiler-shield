# Générés automatiquement par php bin/console guardian:setup
GUARDIAN_LOGIN_PATH=/internal/REMPLACER_PAR_CHEMIN_FORT_UNIQUE
GUARDIAN_ENCRYPTION_KEY=REMPLACER_PAR_CLE_64_CARACTERES_HEX
GUARDIAN_COLLECTION_BRIDGE=1
# Pages d’erreur Symfony détaillées seulement pour une session Guardian authentifiée.
GUARDIAN_DEBUG_ERRORS_FOR_AUTHENTICATED=1
# 0 = masque X-Powered-By ; 1 = expose PHP/x.y.z (risqué).
GUARDIAN_SHOW_PHP_VERSION=0
